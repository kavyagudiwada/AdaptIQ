# PostgreSQL (asyncpg). Replace the password with your own.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/learnai

# --- AI provider -----------------------------------------------------------
# AI_PROVIDER accepts: gemini | openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- App -------------------------------------------------------------------
# Allowed frontend origins. Comma separate to allow more than one.
FRONTEND_URL=http://localhost:5173
DEBUG=false

# --- Auth ------------------------------------------------------------------
# Signing key for session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development and an ephemeral key is generated at startup
# (sessions then reset whenever the server restarts).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080

# --- Google sign-in (optional) ----------------------------------------------
# Leave both blank to hide the "Sign in with Google" button. The redirect URI to
# register with Google is {backend_url}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
