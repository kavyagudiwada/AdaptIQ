# Public frontend config only. Never put AI or database secrets here.
VITE_API_URL=http://localhost:8000

# Sign-in and sign-up endpoints, relative to VITE_API_URL/api. Both must map to
# the FastAPI routes under /api/auth and must accept an email, password, and
# (for sign-up) a name, returning { access_token, token_type, expires_in, account }.
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REGISTER_PATH=/auth/register
